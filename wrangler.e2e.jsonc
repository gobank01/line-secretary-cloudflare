{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "line-secretary-cloudflare-e2e",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "line-secretary-cloudflare-e2e",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    {
      "name": "line-secretary-group-summarizer-e2e",
      "binding": "GROUP_SUMMARIZER",
      "class_name": "GroupSummarizer"
    }
  ],
  "triggers": { "crons": ["*/30 * * * *"] },
  "vars": {
    "APP_ENV": "e2e",
    "APP_TIMEZONE": "Asia/Bangkok",
    "OPENROUTER_MODEL": "test/no-network",
    "REAL_GROUP_LIMIT": "10",
    "AUTOMATED_MONTHLY_PUSH_CAP": "280",
    "AI_DAILY_CALL_CAP": "120",
    "AI_DAILY_INPUT_TOKEN_CAP": "500000",
    "AI_MIN_MESSAGES": "5",
    "AI_MAX_WAIT_MINUTES": "120",
    "LINE_PUSH_ENABLED": "false",
    "DASHBOARD_URL": "http://127.0.0.1:4173",
    "DASHBOARD_PASSWORD": "local-owner-password",
    "SESSION_SECRET": "e2e-only-session-secret-at-least-32-bytes",
    "LINE_CHANNEL_SECRET": "e2e-no-network",
    "LINE_CHANNEL_ACCESS_TOKEN": "e2e-no-network",
    "OWNER_USER_ID": "e2e-no-network",
    "OPENROUTER_API_KEY": "e2e-no-network"
  }
}
