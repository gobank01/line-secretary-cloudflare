{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "types": [
      "node",
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "vercel-adapter",
    "scripts/smoke-vercel.ts",
    "scripts/seed-demo-turso.ts",
    "worker",
    "scripts/demo-data.ts"
  ]
}