{
  "name": "line-secretary-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wizard": "bash scripts/wizard.sh",
    "wizard:check": "bash scripts/wizard.sh check",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && CLOUDFLARE_ENV=preview vite build && node scripts/assert-deploy-config.mjs preview",
    "build:production": "tsc -b && CLOUDFLARE_ENV=production vite build && node scripts/assert-deploy-config.mjs production",
    "preview": "vite preview",
    "deploy": "npm run deploy:preview",
    "deploy:preview": "npm run build:preview && CLOUDFLARE_ENV=preview wrangler deploy",
    "deploy:production": "npm run build:production && CLOUDFLARE_ENV=production wrangler deploy",
    "dry-run:preview": "npm run build:preview && CLOUDFLARE_ENV=preview wrangler deploy --dry-run",
    "dry-run:production": "npm run build:production && CLOUDFLARE_ENV=production wrangler deploy --dry-run",
    "typecheck": "tsc -b && tsc -p tsconfig.worker-tests.json && tsc -p tsconfig.vercel.json",
    "test:worker": "vitest run --config vitest.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test": "npm run test:worker && npm run test:ui",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply line-secretary-cloudflare --local",
    "seed:demo:local": "tsx scripts/seed-demo.ts --local",
    "db:migrate:e2e": "wrangler d1 migrations apply line-secretary-cloudflare-e2e --local --config wrangler.e2e.jsonc",
    "seed:demo:e2e": "tsx scripts/seed-demo.ts --local --config wrangler.e2e.jsonc --database line-secretary-cloudflare-e2e",
    "e2e:serve": "npm run db:migrate:e2e && npm run seed:demo:e2e && CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=./wrangler.e2e.jsonc vite --host 127.0.0.1 --port 4173",
    "seed:demo:preview": "tsx scripts/seed-demo.ts --remote --env preview --database line-secretary-cloudflare-preview",
    "seed:demo:production": "tsx scripts/seed-demo.ts --remote --env production --database line-secretary-cloudflare-production",
    "build:vercel": "vite build --config vite.vercel.config.ts && node scripts/build-api.mjs",
    "migrate:turso": "node scripts/migrate-turso.mjs",
    "smoke:vercel": "tsx scripts/smoke-vercel.ts",
    "seed:demo:turso": "tsx scripts/seed-demo-turso.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@vercel/functions": "^3.9.5",
    "hono": "^4.13.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "jsonc-parser": "^3.3.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}